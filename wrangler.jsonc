// Cloudflare Worker that serves the static contact pages in ./public
// david → /david, indi → /indi. Add a person by adding public/<name>/index.html.
{
  "name": "contact-card",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
